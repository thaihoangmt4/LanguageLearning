# Backend image published by CI to GitHub Container Registry.
# Use an immutable Git commit SHA for production deployments when available.
# Example: ghcr.io/<github-owner>/language-learning-backend
BACKEND_IMAGE=
BACKEND_IMAGE_TAG=latest

# PostgreSQL initialization. Set all three values in the EC2 production .env file.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# ASP.NET Core uses double underscores for nested configuration keys.
# Keep Host=postgres and Port=5432 so the backend uses private Docker DNS.
# Example: Host=postgres;Port=5432;Database=<database>;Username=<user>;Password=<password>
ConnectionStrings__DefaultConnection=

# Authentication and Google OAuth.
# Jwt__Secret should be a strong random secret of at least 32 characters.
Jwt__Secret=
Google__ClientId=

# Allowed browser origin for the separately deployed client application.
# Example: https://app.example.com
Cors__AllowedOrigins__0=

# Exact Docker host-side address of the trusted Nginx reverse proxy.
ReverseProxy__KnownProxy=172.18.0.1

# DeepSeek exercise-generation provider.
DeepSeek__ApiKey=

# Secure manual migration API. No migration runs automatically.
# Enable only when POST /api/system/database/migrate is intentionally used.
Migration__Enabled=false
Migration__ApiKey=

# Redis is available privately at redis:6379. The application currently defines
# no Redis configuration key, so no duplicate or unused convention is invented here.
